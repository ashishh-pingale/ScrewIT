# PostgreSQL credentials used by Docker Compose and local development.
POSTGRES_DB=screwit
POSTGRES_USER=screwit
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_PORT=5432

# Backend configuration. Host is `db` from inside Docker Compose.
DATABASE_URL=postgresql+psycopg://screwit:change-me-for-local-use@localhost:5432/screwit
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Browser-exposed base URL for the web client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
